pipeline {
    agent any

    environment {
        IMAGE_NAME = "haravinashivaprasad1/maven-exam1"
    }

    stages {
        // 1. Always pull the code first
        stage('Checkout') {
            steps {
                git url: 'https://github.com/haravinashivaprasad1-afk/mavanexams.git', branch: 'main'
            }
        }

        // 2. Build and analyze code in one efficient step
        stage('Build & SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv('haravinashivaprasad1-afk') {
                        // This builds the app AND runs the code scan together
                        sh "mvn clean package sonar:sonar" 
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Using 'def' or global context to ensure visibility
                    IMAGE = docker.build("${IMAGE_NAME}:latest")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker') {
                        IMAGE.push('latest')
                    }
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}

